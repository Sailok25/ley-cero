
---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ultimo = {
  titulo: 'Jim Beam',
  url: 'https://open.spotify.com/track/10TGRKQ2IR2WP5Wp4ijOVX',
  embed: 'https://open.spotify.com/embed/album/2a3rXi1n5tQobDw6pSK3Ox',
};

const eventos = [
  { fecha: '25 OCT', lugar: 'Olivenza', tipo: 'Evento', url: '' },
  { fecha: '7 NOV', lugar: 'Mérida', tipo: 'Evento', url: '' },
  { fecha: '14 NOV', lugar: 'Jerez de los Caballeros', tipo: 'Concurso', url: '' },
];

const frase = 'Escucha ya nuestro último single ✦ Escucha ya nuestro último single ✦ Escucha ya nuestro último single ✦';
---

<Base title="Ley Cero">
  <!-- HERO -->
  <section class="hero hero-home">
    <div class="hero-photo">
      <img
        src={`${base}/img/ley_cero.webp`}
        alt="Ley Cero"
        fetchpriority="high"
      />
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="hero-copy">
        <h1 class="rough">
          LEY
          <span>CERO</span>
        </h1>

        <div class="cta">
          <a class="btn" href={`${base}/musica`}>Escuchar música</a>
          <a class="btn ghost" href={`${base}/contacto`}>Contratar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <span>{frase.repeat(8)}</span>
  </div>

  <!-- ÚLTIMO SINGLE -->
  <section class="section wrap" style="margin-top:2rem">
    <div class="duo">
      <div>
        <span class="tape">Último single</span>
        <h2 class="rough" style="margin-top:1.2rem">{ultimo.titulo}</h2>
        <p style="margin-block:1.5rem">Ya disponible en Spotify.</p>
        <a class="btn" href={ultimo.url} rel="noopener">Escuchar ahora</a>
      </div>

      <iframe
        title={`${ultimo.titulo} en Spotify`}
        src={ultimo.embed}
        width="100%"
        height="152"
        style={{ border: 0, borderRadius: '12px' }}
        loading="lazy"
        allow="encrypted-media"
      />
    </div>
  </section>

  <!-- EVENTOS -->
  <section class="paper">
    <div class="wrap">
      <h2 class="rough">Eventos y conciertos</h2>

      {eventos.length > 0 ? (
        <ul class="rows">
          {eventos.map((e) => (
            <li>
              <span class="date">{e.fecha}</span>
              <span class="city">
                {e.lugar}
                <small>{e.tipo}</small>
              </span>
              {e.url ? (
                <a class="btn" href={e.url} rel="noopener">Info</a>
              ) : (
                <span></span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p style="margin-top:2rem">
          Pronto anunciaremos nuevas fechas. Síguenos en
          <a href="https://instagram.com/leycer0" rel="noopener"> Instagram</a>
          para no perdértelas.
        </p>
      )}
    </div>

    <div class="home-links-spacer"></div>

    <!-- DESCUBRE LA BANDA -->
    <div class="wrap duo">
      <div>
        <h2 class="rough">La banda</h2>
        <p style="margin-block:1.5rem">
          Quiénes somos, qué toca cada uno y de dónde venimos.
        </p>
        <a class="btn" href={`${base}/labanda`}>Conócenos</a>
      </div>

      <div>
        <h2 class="rough">Música</h2>
        <p style="margin-block:1.5rem">
          Singles, EP y vídeos en nuestro canal de YouTube.
        </p>
        <a class="btn" href={`${base}/musica`}>Ver música</a>
      </div>
    </div>
  </section>
</Base>
