---
import Base from '../layouts/Base.astro';
const formAction = 'https://formspree.io/f/TU_ID';
---
<Base title="Contacto" description="Contrata a Ley Cero o escríbenos.">
  <section class="paper" style="margin-top:1rem">
    <div class="wrap">
      <h2 class="rough">Contacto</h2>
<p style="max-width:46ch;margin:1.5rem 0 2.5rem">¿Un concierto, una colaboración o prensa? Escríbenos y te respondemos lo antes posible.</p>
      <form action={formAction} method="POST">
        <div><label for="nombre">Nombre</label><input id="nombre" name="nombre" required autocomplete="name" /></div>
        <div><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
        <div><label for="motivo">Motivo</label>
          <select id="motivo" name="motivo">
            <option>Contratación</option><option>Prensa</option><option>Colaboración</option><option>Otro</option>
          </select></div>
        <div><label for="mensaje">Mensaje</label><textarea id="mensaje" name="mensaje" rows="6" required></textarea></div>
        <div><button class="btn" type="submit">Enviar</button></div>
      </form>
    </div>
  </section>
</Base>
