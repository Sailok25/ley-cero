---
import Base from '../layouts/Base.astro';
// Sustituye por tus lanzamientos reales
const discos = [
  { titulo: 'Título del single', tipo: 'Single', anio: '2026' },
  { titulo: 'Título del EP', tipo: 'EP', anio: '2025' },
];
// Pega aquí el enlace embed de Spotify (Compartir > Insertar artista)
const spotifyEmbed = '';
---
<Base title="Música" description="Escucha a Ley Cero en Spotify y YouTube.">
  <section class="section wrap">
    <h2 class="rough">Música</h2>
    <div style="margin-top:2.5rem">
      {spotifyEmbed
        ? <iframe title="Ley Cero en Spotify" src={spotifyEmbed} width="100%" height="352" style="border:0" loading="lazy" allow="encrypted-media"></iframe>
        : <div class="ph" style="aspect-ratio:16/6">Aquí va el reproductor de Spotify</div>}
    </div>
  </section>
  <section class="paper">
    <div class="wrap">
      <h2 class="rough">Discografía</h2>
      <ul class="rows">
        {discos.map((d) => (
          <li>
            <span class="date">{d.anio}</span>
            <span class="city">{d.titulo}<small>{d.tipo}</small></span>
            <a class="btn" href="https://open.spotify.com/" rel="noopener">Play</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section wrap">
    <h3>Directos y videoclips</h3>
    <p style="margin-block:1rem 2rem">Mira los vídeos en nuestro canal.</p>
    <a class="btn ghost" href="https://youtube.com/@ley_cero" rel="noopener">Canal de YouTube</a>
  </section>
</Base>
