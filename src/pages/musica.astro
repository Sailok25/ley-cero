---
import Base from '../layouts/Base.astro';

const spotifyEmbed = 'https://open.spotify.com/embed/artist/5A88T1eUwJqZIyeOjgGs5G';

// Próximo lanzamiento. Si no hay, déjalo en null.
const proximo = null;
// const proximo = { titulo: 'TÍTULO', fecha: '12 NOV' };

// Lanzamientos. 'url' es el enlace al álbum/single; 'canciones' es opcional (para EPs).
const lanzamientos = [
  {
    titulo: 'Tu Aire',
    tipo: 'Single',
    anio: '2026',
    url: 'https://open.spotify.com/intl-es/album/7uyQxVky0YyIoa4NYZKB7W',
  },
  {
    titulo: 'LEY CERO',
    tipo: 'EP',
    anio: '2025',
    url: 'https://open.spotify.com/intl-es/album/0llwSxup4XGaE22AeyPZi5',
    canciones: [
      { titulo: 'LA INNOMBRABLE', url: 'https://open.spotify.com/intl-es/track/6tvgEOUca00b7ofdYPhhPA' },
      { titulo: 'LA ONCE', url: 'https://open.spotify.com/intl-es/track/1TcEAKUCwhhVDRMNGkFFJh' },
      { titulo: 'VISTA DE SOL', url: 'https://open.spotify.com/intl-es/track/3Xzk8FWxEpbdh96RYu47su' },
      { titulo: 'LEY CERO', url: 'https://open.spotify.com/intl-es/track/6ocoqlA3xmnuP7RRsog8Xe' },
    ],
  },
  {
    titulo: 'La ONCE',
    tipo: 'Single',
    anio: '2025',
    url: 'https://open.spotify.com/intl-es/album/3wDGQp31fwcW07gHsw9XRr',
  },
];
---
<Base title="Música" description="Escucha a Ley Cero en Spotify y YouTube.">
  <section class="section wrap">
    <h2 class="rough">Música</h2>
    {proximo && (
      <p style="margin-top:2rem">
        <span class="tape">Próximamente · {proximo.fecha}</span>
        <span style="display:block;margin-top:1rem;font-family:var(--display);font-size:clamp(2rem,6vw,4rem);text-transform:uppercase;line-height:1">{proximo.titulo}</span>
      </p>
    )}
    <div style="margin-top:2.5rem">
      <iframe title="Ley Cero en Spotify" src={spotifyEmbed} width="100%" height="352" style="border:0" loading="lazy" allow="encrypted-media"></iframe>
    </div>
  </section>

  <section class="paper">
    <div class="wrap">
      <h2 class="rough">Discografía</h2>
      <ul class="rows">
        {lanzamientos.map((l) => (
          <li>
            <span class="date">{l.anio}</span>
            <span class="city">{l.titulo}<small>{l.tipo}</small></span>
            <a class="btn" href={l.url} rel="noopener">Play</a>
            {l.canciones && (
              <details class="tracks">
                <summary>Ver canciones</summary>
                <ol>
                  {l.canciones.map((c) => (
                    <li><a href={c.url} rel="noopener">{c.titulo}</a></li>
                  ))}
                </ol>
              </details>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>