---
import Base from '../layouts/Base.astro';
// Pon tus fotos en /public/img y añade src: '/img/foto1.jpg'
const fotos = [
  { alt: 'Concierto en directo' },
  { alt: 'Ensayo en el local' },
  { alt: 'Sesión de fotos' },
  { alt: 'Backstage' },
  { alt: 'Público' },
  { alt: 'Portada del single' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Galería" description="Fotos de Ley Cero en directo y en el local de ensayo.">
  <section class="section wrap">
    <h2 class="rough">Galería</h2>
    <div class="grid">
      {fotos.map((f) => (
        <figure class="card" style="margin:0">
          {f.src
            ? <img src={`${base}${f.src}`} alt={f.alt} loading="lazy" style="aspect-ratio:4/5;object-fit:cover;filter:grayscale(1) contrast(1.3)" />
            : <div class="ph" role="img" aria-label={f.alt}>Foto<br />{f.alt}</div>}
        </figure>
      ))}
    </div>
  </section>
</Base>
